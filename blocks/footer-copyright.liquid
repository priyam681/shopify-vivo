
{% assign block_settings = block.settings %}
<div
  class="
    footer-utilities__group-copyright
    custom-typography
    {% if block_settings.font_size != "" %}custom-font-size{% endif %}
  "
  style="{% render 'typography-style', preset: 'custom', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  <span class="footer-utilities__text">
    &copy; {{ 'now' | date: '%Y' }}
    {{ shop.name | link_to: routes.root_url -}}.
    {{ block_settings.rights_reserved_text | default: 'All rights reserved.' }}
    {%- if block_settings.show_powered_by -%}
      , {{ powered_by_link }}
    {%- endif -%}
  </span>
</div>

{% stylesheet %}
  .footer-utilities__group-copyright.custom-font-size,
  .footer-utilities__group-copyright.custom-font-size > * {
    font-size: var(--font-size);
  }

  @media (max-width: 991px) {
    .footer-utilities__group-copyright.custom-font-size,
    .footer-utilities__group-copyright.custom-font-size > * {
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.copyright",
  "tag": "div",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "t:settings.show_powered_by_shopify",
      "default": true
    },
    {
      "type": "text",
      "id": "rights_reserved_text",
      "label": "All rights reserved text",
      "default": "All rights reserved."
    },
    {
      "type": "paragraph",
      "content": "t:content.manage_store_name"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "t:settings.size",
      "options": [
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.8125rem",
          "label": "13px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "0.9375rem",
          "label": "15px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.0625rem",
          "label": "17px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "0.9375rem"
    },
    {
      "type": "select",
      "id": "case",
      "label": "t:settings.case",
      "options": [
        {
          "value": "none",
          "label": "t:options.default"
        },
        {
          "value": "uppercase",
          "label": "t:options.uppercase"
        }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:names.copyright",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
