<section
  class="motion-editorial-gallery color-{{ section.settings.color_scheme }} gradient"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --image-gap: {{ section.settings.image_gap }}px;
    --border-radius: {{ section.settings.border_radius }}px;
    --animation-speed: {{ section.settings.animation_speed }}s;
  "
>

  <div class="motion-editorial-gallery__track">

    {% for i in (1..2) %}

      {% for block in section.blocks %}

        <div
          class="motion-editorial-gallery__column motion-editorial-gallery__column--{{ block.settings.layout }}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image_1 != blank %}

            <div class="motion-editorial-gallery__image-wrapper motion-editorial-gallery__image-wrapper--{{ block.settings.image_1_height }}">

              {{
                block.settings.image_1
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,1000,1200,1400,1600',
                  sizes: '(min-width: 990px) 30vw, 80vw',
                  class: 'motion-editorial-gallery__image'
              }}

            </div>

          {% endif %}

          {% if block.settings.layout == 'double' and block.settings.image_2 != blank %}

            <div class="motion-editorial-gallery__image-wrapper motion-editorial-gallery__image-wrapper--{{ block.settings.image_2_height }}">

              {{
                block.settings.image_2
                | image_url: width: 1600
                | image_tag:
                  loading: 'lazy',
                  widths: '400,600,800,1000,1200,1400,1600',
                  sizes: '(min-width: 990px) 30vw, 80vw',
                  class: 'motion-editorial-gallery__image'
              }}

            </div>

          {% endif %}

        </div>

      {% endfor %}

    {% endfor %}

  </div>

</section>

{{% stylesheet %}}
  .motion-editorial-gallery{
    overflow:hidden;
    padding-top:var(--padding-top);
    padding-bottom:var(--padding-bottom);
  }

  .motion-editorial-gallery__track{
    display:flex;
    align-items:flex-start;
    gap:var(--column-gap);
    width:max-content;
    animation:motionEditorialScroll var(--animation-speed) linear infinite;
  }

  {% if section.settings.pause_on_hover %}
  .motion-editorial-gallery__track:hover{
    animation-play-state:paused;
  }
  {% endif %}

  .motion-editorial-gallery__column{
    display:flex;
    flex-direction:column;
    gap:var(--image-gap);
    flex-shrink:0;
  }

  .motion-editorial-gallery__column--small{
    width:18rem;
  }

  .motion-editorial-gallery__column--medium{
    width:32rem;
  }

  .motion-editorial-gallery__column--large{
    width:44rem;
  }

  .motion-editorial-gallery__image-wrapper{
    overflow:hidden;
    border-radius:var(--border-radius);
  }

  .motion-editorial-gallery__image-wrapper--small{
    height:22rem;
  }

  .motion-editorial-gallery__image-wrapper--medium{
    height:38rem;
  }

  .motion-editorial-gallery__image-wrapper--large{
    height:56rem;
  }

  .motion-editorial-gallery__image{
    width:100%;
    height:100%;
    object-fit:{{ section.settings.image_fit }};
    display:block;
    transition:transform .5s ease;
  }

  {% if section.settings.enable_hover_zoom %}
  .motion-editorial-gallery__image-wrapper:hover .motion-editorial-gallery__image{
    transform:scale(1.05);
  }
  {% endif %}

  @keyframes motionEditorialScroll{
    from{
      transform:translateX(0);
    }
    to{
      transform:translateX(-50%);
    }
  }

  @media screen and (max-width: 989px){

    .motion-editorial-gallery__column--small{
      width:14rem;
    }

    .motion-editorial-gallery__column--medium{
      width:22rem;
    }

    .motion-editorial-gallery__column--large{
      width:30rem;
    }

    .motion-editorial-gallery__image-wrapper--small{
      height:18rem;
    }

    .motion-editorial-gallery__image-wrapper--medium{
      height:28rem;
    }

    .motion-editorial-gallery__image-wrapper--large{
      height:40rem;
    }
  }

  @media screen and (max-width: 749px){

    .motion-editorial-gallery__track{
      gap:1.2rem;
    }

    .motion-editorial-gallery__column{
      gap:1.2rem;
    }

    .motion-editorial-gallery__column--small{
      width:10rem;
    }

    .motion-editorial-gallery__column--medium{
      width:16rem;
    }

    .motion-editorial-gallery__column--large{
      width:22rem;
    }

    .motion-editorial-gallery__image-wrapper--small{
      height:12rem;
    }

    .motion-editorial-gallery__image-wrapper--medium{
      height:20rem;
    }

    .motion-editorial-gallery__image-wrapper--large{
      height:30rem;
    }
  }
{{% endstylesheet %}}

{% schema %}
{
  "name": "Motion editorial gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },

  "settings": [

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "Slider settings"
    },

    {
      "type": "range",
      "id": "animation_speed",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Animation speed",
      "default": 40
    },

    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Enable hover zoom",
      "default": true
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Column gap",
      "default": 24
    },

    {
      "type": "range",
      "id": "image_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Image gap",
      "default": 24
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image radius",
      "default": 0
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }

  ],

  "blocks": [

    {
      "type": "gallery_column",
      "name": "Gallery column",
      "settings": [

        {
          "type": "select",
          "id": "layout",
          "label": "Column layout",
          "default": "double",
          "options": [
            {
              "value": "small",
              "label": "Single small"
            },
            {
              "value": "medium",
              "label": "Single medium"
            },
            {
              "value": "large",
              "label": "Single large"
            },
            {
              "value": "double",
              "label": "Two stacked images"
            }
          ]
        },

        {
          "type": "image_picker",
          "id": "image_1",
          "label": "First image"
        },

        {
          "type": "select",
          "id": "image_1_height",
          "label": "First image height",
          "default": "medium",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        },

        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Second image"
        },

        {
          "type": "select",
          "id": "image_2_height",
          "label": "Second image height",
          "default": "medium",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        }

      ]
    }

  ],

  "presets": [
    {
      "name": "Motion editorial gallery",
      "blocks": [
        {
          "type": "gallery_column"
        },
        {
          "type": "gallery_column"
        },
        {
          "type": "gallery_column"
        },
        {
          "type": "gallery_column"
        }
      ]
    }
  ]
}
{% endschema %}