<section
  class="motion-gallery color-{{ section.settings.color_scheme }} gradient"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;

    --section-height: {{ section.settings.section_height }}px;

    --column-gap: {{ section.settings.column_gap }}px;
    --border-radius: {{ section.settings.border_radius }}px;

    --animation-speed: {{ section.settings.animation_speed }}s;

    --desktop-small-width: {{ section.settings.desktop_small_width }}rem;
    --desktop-medium-width: {{ section.settings.desktop_medium_width }}rem;
    --desktop-large-width: {{ section.settings.desktop_large_width }}rem;

    --mobile-small-width: {{ section.settings.mobile_small_width }}rem;
    --mobile-medium-width: {{ section.settings.mobile_medium_width }}rem;
    --mobile-large-width: {{ section.settings.mobile_large_width }}rem;
  "
>

  <div class="motion-gallery__track">

    {% for block in section.blocks %}

      {% if block.type == 'image' %}

        <div
          class="motion-gallery__item motion-gallery__item--{{ block.settings.image_size }}"
          {{ block.shopify_attributes }}
        >

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '300,500,700,900,1200,1400,1600',
                sizes: '(min-width: 990px) 25vw, 50vw',
                class: 'motion-gallery__image'
            }}

          {% else %}

            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}

          {% endif %}

        </div>

      {% endif %}

    {% endfor %}

    {% for block in section.blocks %}

      {% if block.type == 'image' %}

        <div class="motion-gallery__item motion-gallery__item--{{ block.settings.image_size }}">

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '300,500,700,900,1200,1400,1600',
                sizes: '(min-width: 990px) 25vw, 50vw',
                class: 'motion-gallery__image'
            }}

          {% endif %}

        </div>

      {% endif %}

    {% endfor %}

  </div>

</section>

{{% stylesheet %}}
  .motion-gallery{
    overflow:hidden;
    padding-top:var(--padding-top);
    padding-bottom:var(--padding-bottom);
  }

  .motion-gallery__track{
    display:flex;
    align-items:flex-start;
    gap:var(--column-gap);
    width:max-content;
    animation:motionGalleryScroll var(--animation-speed) linear infinite;
  }

  {% if section.settings.pause_on_hover %}
  .motion-gallery__track:hover{
    animation-play-state:paused;
  }
  {% endif %}

  .motion-gallery__item{
    overflow:hidden;
    border-radius:var(--border-radius);
    flex-shrink:0;
  }

  .motion-gallery__item--small{
    width:var(--desktop-small-width);
  }

  .motion-gallery__item--medium{
    width:var(--desktop-medium-width);
  }

  .motion-gallery__item--large{
    width:var(--desktop-large-width);
  }

  .motion-gallery__image{
    width:100%;
    height:var(--section-height);
    object-fit:{{ section.settings.image_fit }};
    display:block;
    transition:transform .5s ease;
  }

  {% if section.settings.enable_hover_zoom %}
  .motion-gallery__item:hover .motion-gallery__image{
    transform:scale(1.05);
  }
  {% endif %}

  @keyframes motionGalleryScroll{
    from{
      transform:translateX(0);
    }
    to{
      transform:translateX(-50%);
    }
  }

  @media screen and (max-width: 749px){

    .motion-gallery__item--small{
      width:var(--mobile-small-width);
    }

    .motion-gallery__item--medium{
      width:var(--mobile-medium-width);
    }

    .motion-gallery__item--large{
      width:var(--mobile-large-width);
    }

    .motion-gallery__image{
      height:calc(var(--section-height) * .7);
    }
  }
{{% endstylesheet %}}

{% schema %}
{
  "name": "Motion gallery",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },

  "settings": [

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "header",
      "content": "Slider settings"
    },

    {
      "type": "range",
      "id": "animation_speed",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Animation speed",
      "default": 40
    },

    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },

    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Enable hover zoom",
      "default": true
    },

    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ]
    },

    {
      "type": "header",
      "content": "Desktop image widths"
    },

    {
      "type": "range",
      "id": "desktop_small_width",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "rem",
      "label": "Small image width",
      "default": 18
    },

    {
      "type": "range",
      "id": "desktop_medium_width",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "rem",
      "label": "Medium image width",
      "default": 32
    },

    {
      "type": "range",
      "id": "desktop_large_width",
      "min": 30,
      "max": 80,
      "step": 1,
      "unit": "rem",
      "label": "Large image width",
      "default": 42
    },

    {
      "type": "header",
      "content": "Mobile image widths"
    },

    {
      "type": "range",
      "id": "mobile_small_width",
      "min": 8,
      "max": 30,
      "step": 1,
      "unit": "rem",
      "label": "Small image width",
      "default": 12
    },

    {
      "type": "range",
      "id": "mobile_medium_width",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "rem",
      "label": "Medium image width",
      "default": 18
    },

    {
      "type": "range",
      "id": "mobile_large_width",
      "min": 18,
      "max": 50,
      "step": 1,
      "unit": "rem",
      "label": "Large image width",
      "default": 22
    },

    {
      "type": "header",
      "content": "Layout"
    },

    {
      "type": "range",
      "id": "section_height",
      "min": 200,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Image height",
      "default": 520
    },

    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Column gap",
      "default": 24
    },

    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Image radius",
      "default": 0
    },

    {
      "type": "header",
      "content": "Spacing"
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }

  ],

  "blocks": [

    {
      "type": "image",
      "name": "Image",
      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "select",
          "id": "image_size",
          "label": "Image width",
          "default": "medium",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ]
        }

      ]
    }

  ],

  "presets": [
    {
      "name": "Motion gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}