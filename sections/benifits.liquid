{% endschema %}

<section
  id="barefoot-benefits-{{ section.id }}"
  class="barefoot-benefits color-{{ section.settings.color_scheme }}"
>
  <div class="barefoot-benefits__wrapper">

    {% for block in section.blocks %}

      {% case block.type %}

        {% when 'heading' %}

          <div class="barefoot-benefits__heading" {{ block.shopify_attributes }}>
            <h2>{{ block.settings.heading }}</h2>
          </div>

        {% when 'description' %}

          <div class="barefoot-benefits__description" {{ block.shopify_attributes }}>
            {{ block.settings.description }}
          </div>

      {% endcase %}

    {% endfor %}

    <div class="barefoot-benefits__stats">

      {% for block in section.blocks %}
        {% if block.type == 'stat' %}

         <div class="barefoot-benefits__stat barefoot-benefits__stat--{{ block.id }}" {{ block.shopify_attributes }}>            <h3>{{ block.settings.number }}</h3>
            <p>{{ block.settings.caption }}</p>
          </div>

        {% endif %}
      {% endfor %}

    </div>

    {% for block in section.blocks %}

      {% case block.type %}

        {% when 'button' %}

          <div class="barefoot-benefits__button" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.button_link }}" class="button">
              {{ block.settings.button_label }}
            </a>
          </div>

        {% when 'footnote' %}

          <div class="barefoot-benefits__footnote" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>

      {% endcase %}

    {% endfor %}

  </div>
</section>

<style>
  #barefoot-benefits-{{ section.id }} {
    background: {{ section.settings.section_bg }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__wrapper {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: {{ section.settings.text_align }};
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__heading h2 {
    margin: 0;
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__description {
    margin: 0 auto;
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__description p {
    margin: 0 0 20px;
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
    justify-content: center;
    align-items: center;
    max-width: 700px;
    margin: 0 auto;
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__stat h3 {
    margin: 0 0 10px;
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__stat p {
    margin: 0;
  }

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.3s ease;
  }

 

  #barefoot-benefits-{{ section.id }} .barefoot-benefits__footnote {
    margin-top: 10px;
  }

  @media screen and (max-width: 768px) {

    #barefoot-benefits-{{ section.id }} .barefoot-benefits__stats {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    #barefoot-benefits-template--26765566312752__benifits_adaXym .barefoot-benefits__heading h2 {
        font-size: 48px !important;
        letter-spacing: -0.03em;
        line-height: 35px;
    }
    #barefoot-benefits-{{ section.id }} .barefoot-benefits__heading { 
      margin-bottom: 20px;
    }
    #barefoot-benefits-{{ section.id }}  .barefoot-benefits__description p {
      font-size: 16px !important;
      margin-bottom: 16px;
      line-height: 23px !important;
    }
  }

  {% for block in section.blocks %}

    {% case block.type %}

      {% when 'heading' %}

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__heading {
          margin-bottom: {{ block.settings.margin_bottom }}px;
        }

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__heading h2 {
          color: {{ block.settings.color }};
          font-size: {{ block.settings.font_size }}px;
          line-height: {{ block.settings.line_height }};
          letter-spacing: {{ block.settings.letter_spacing }}px;
          font-weight: {{ block.settings.font_weight }};
          text-transform: uppercase;
        }

      {% when 'description' %}

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__description {
          max-width: {{ block.settings.max_width }}px;
          margin-bottom: {{ block.settings.margin_bottom }}px;
          color: {{ block.settings.color }};
          font-size: {{ block.settings.font_size }}px;
          line-height: {{ block.settings.line_height }};
          font-weight: {{ block.settings.font_weight }};
        }

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__description p {
          color: {{ block.settings.color }};
          font-size: {{ block.settings.font_size }}px;
          line-height: {{ block.settings.line_height }};
          font-weight: {{ block.settings.font_weight }};
        }

      {% when 'stat' %}

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__stat--{{ block.id }} h3 {
        color: {{ block.settings.number_color }};
        font-size: {{ block.settings.number_size }}px;
        font-weight: {{ block.settings.number_weight }};
        line-height: 1;
        }

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__stat--{{ block.id }} p {
        color: {{ block.settings.caption_color }};
        font-size: {{ block.settings.caption_size }}px;
        line-height: 1.5;
        }

      {% when 'button' %}

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__button {
          margin-top: {{ block.settings.margin_top }}px;
          margin-bottom: {{ block.settings.margin_bottom }}px;
        }

    
      {% when 'footnote' %}

        #barefoot-benefits-{{ section.id }} .barefoot-benefits__footnote {
          color: {{ block.settings.color }};
          font-size: {{ block.settings.font_size }}px;
          font-weight: {{ block.settings.font_weight }};
        }

    {% endcase %}

  {% endfor %}
</style>