<section
  id="activity-showcase-{{ section.id }}"
  class="activity-showcase color-{{ section.settings.color_scheme }} page-width"
>
  <div class="page-width">

    {% if section.settings.heading != blank %}
      <div class="activity-showcase__top-heading">
        {{ section.settings.heading }}
      </div>
    {% endif %}

    <div class="activity-showcase__wrapper">

     <div class="activity-showcase__image activity-showcase__image--left">
        {% assign first_block = section.blocks.first %}

        {% if first_block.settings.left_image != blank %}
            <img
            src="{{ first_block.settings.left_image | image_url: width: 800 }}"
            alt=""
            loading="lazy"
            class="activity-showcase__main-image activity-showcase__main-image--left"
            width=""
            height=""
            >
        {% endif %}
        </div>
      <div class="activity-showcase__content">

        {% for block in section.blocks %}

          <div
            class="activity-showcase__item activity-showcase__item--{{ block.id }} is-hover"
            data-image-left="{% if block.settings.left_image != blank %}{{ block.settings.left_image | image_url: width: 800 }}{% endif %}"
            data-image-right="{% if block.settings.right_image != blank %}{{ block.settings.right_image | image_url: width: 800 }}{% endif %}"
            {{ block.shopify_attributes }}
          >

            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="activity-showcase__link"
              >
            {% endif %}

            <span class="activity-showcase__text">
              {{ block.settings.title }}
            </span>

            {% if block.settings.link != blank %}
              </a>
            {% endif %}

          </div>

        {% endfor %}

      </div>

      <div class="activity-showcase__image activity-showcase__image--right">
        {% assign first_block = section.blocks.first %}
        {% if first_block.settings.right_image != blank %}
          {{
            first_block.settings.right_image
            | image_url: width: 800
            | image_tag:
              loading: 'lazy',
              class: 'activity-showcase__main-image activity-showcase__main-image--right'
          }}
        {% endif %}
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Activity Showcase",
  "tag": "section",
  "class": "activity-showcase-section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Top Heading",
      "default": "ACTIVITIES"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "label": "Desktop Image Width",
      "min": 100,
      "max": 500,
      "step": 10,
      "unit": "px",
      "default": 220
    },
    {
      "type": "range",
      "id": "mobile_image_width",
      "label": "Mobile Image Width",
      "min": 80,
      "max": 250,
      "step": 10,
      "unit": "px",
      "default": 120
    }
  ],
  "blocks": [
    {
      "type": "activity",
      "name": "Activity Item",
      "limit": 12,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Activity Title",
          "default": "HIKING"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Activity Link"
        },
        {
          "type": "image_picker",
          "id": "left_image",
          "label": "Left Image"
        },
        {
          "type": "image_picker",
          "id": "right_image",
          "label": "Right Image"
        },
        {
          "type": "range",
          "id": "font_size",
          "label": "Desktop Font Size",
          "min": 20,
          "max": 140,
          "step": 2,
          "unit": "px",
          "default": 74
        },
        {
          "type": "range",
          "id": "mobile_font_size",
          "label": "Mobile Font Size",
          "min": 14,
          "max": 70,
          "step": 2,
          "unit": "px",
          "default": 36
        },
        {
          "type": "select",
          "id": "font_weight",
          "label": "Font Weight",
          "default": "800",
          "options": [
            {
              "value": "400",
              "label": "400"
            },
            {
              "value": "500",
              "label": "500"
            },
            {
              "value": "600",
              "label": "600"
            },
            {
              "value": "700",
              "label": "700"
            },
            {
              "value": "800",
              "label": "800"
            },
            {
              "value": "900",
              "label": "900"
            }
          ]
        },
        {
          "type": "range",
          "id": "line_height",
          "label": "Line Height",
          "min": 0.7,
          "max": 2,
          "step": 0.1,
          "default": 0.9
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text Color",
          "default": "#cfcfcf"
        },
        {
          "type": "color",
          "id": "hover_color",
          "label": "Hover Active Color",
          "default": "#000000"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Activity Showcase",
      "blocks": [
        {
          "type": "activity"
        },
        {
          "type": "activity"
        },
        {
          "type": "activity"
        },
        {
          "type": "activity"
        },
        {
          "type": "activity"
        },
        {
          "type": "activity"
        }
      ]
    }
  ]
}
{% endschema %}

<style>

#activity-showcase-{{ section.id }}{
  padding-top: {{ section.settings.section_padding_top }}px;
  padding-bottom: {{ section.settings.section_padding_bottom }}px;
}

#activity-showcase-{{ section.id }} .activity-showcase__top-heading{
  text-align:center;
  margin-bottom:40px;
  font-weight:700;
  letter-spacing:1px;
}

#activity-showcase-{{ section.id }} .activity-showcase__wrapper{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:40px;
}

#activity-showcase-{{ section.id }} .activity-showcase__image{
  flex:0 0 {{ section.settings.desktop_image_width }}px;
}

#activity-showcase-{{ section.id }} .activity-showcase__main-image{
  width:100%;
  display:block;
  object-fit:cover;
  transition:0.4s ease;
}

#activity-showcase-{{ section.id }} .activity-showcase__content{
  flex:1;
  text-align:center;
}

#activity-showcase-{{ section.id }} .activity-showcase__item{
  cursor:pointer;
}

#activity-showcase-{{ section.id }} .activity-showcase__link{
  text-decoration:none;
}

#activity-showcase-{{ section.id }} .activity-showcase__text{
  transition:0.3s ease;
  display:block;
  text-transform:uppercase;
}

{% for block in section.blocks %}

#activity-showcase-{{ section.id }} .activity-showcase__item--{{ block.id }} .activity-showcase__text{
  font-size: {{ block.settings.font_size }}px;
  font-weight: {{ block.settings.font_weight }};
  line-height: {{ block.settings.line_height }};
  color: {{ block.settings.text_color }};
  transition:0.3s ease;
}

#activity-showcase-{{ section.id }} .activity-showcase__item--{{ block.id }}.is-hover .activity-showcase__text,
#activity-showcase-{{ section.id }} .activity-showcase__item--{{ block.id }}:hover .activity-showcase__text{
  color: {{ block.settings.hover_color }};
}

@media screen and (max-width: 768px){

#activity-showcase-{{ section.id }} .activity-showcase__item--{{ block.id }} .activity-showcase__text{
  font-size: {{ block.settings.mobile_font_size }}px;
}

}

{% endfor %}

@media screen and (max-width: 768px){

#activity-showcase-{{ section.id }} .activity-showcase__wrapper{
  gap:20px;
}

#activity-showcase-{{ section.id }} .activity-showcase__image{
  flex:0 0 {{ section.settings.mobile_image_width }}px;
}
}
@media screen and (max-width: 992px){
  #activity-showcase-{{ section.id }} .activity-showcase__image{
    display:none;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {

  if (window.innerWidth <= 768) {
    return;
  }

  const section = document.querySelector('#activity-showcase-{{ section.id }}');

  if (!section) return;

  const items = section.querySelectorAll('.activity-showcase__item');

  const leftImage = section.querySelector('.activity-showcase__main-image--left');
  const rightImage = section.querySelector('.activity-showcase__main-image--right');

  function activateItem(item){

   items.forEach((el) => {
    el.classList.remove('is-hover');
    });

    item.classList.add('is-hover');

    const leftSrc = item.dataset.imageLeft;
    const rightSrc = item.dataset.imageRight;

    if (leftSrc && leftImage) {
      leftImage.src = leftSrc;
      leftImage.srcset = leftSrc;
    }

    if (rightSrc && rightImage) {
      rightImage.src = rightSrc;
      rightImage.srcset = rightSrc;
    }

  }

  items.forEach((item) => {

    item.addEventListener('mouseenter', () => {
      activateItem(item);
    });

  });

});
</script>