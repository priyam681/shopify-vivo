{{ 'home-page-product.css' | asset_url | stylesheet_tag }}

{% assign has_products = false %}
{% for block in section.blocks %}
  {% assign collection = collections[block.settings.collection] %}
  {% if collection.products.size >= 1 %}
    {% assign has_products = true %}
    {% break %}
  {% endif %}
{% endfor %}
{% if has_products %}
  {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{% endif %}
{% schema %}
{
  "name": "Product Tabs",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "text",
      "id": "tab_heading",
      "label": "Tab Heading",
      "default": "TRENDING"
    },
    {
      "type": "range",
      "id": "tab_padding",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Tab Padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Product Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "MENS"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Product Tabs"
    }
  ]
}
{% endschema %}

{% style  %} 
.product-tabs-section {
    padding-block: {{ section.settings.tab_padding }}px;
  }

{% endstyle %}

{% assign initial_tab_title = blank %}
{% assign initial_collection_url = '#' %}
{% for block in section.blocks %}
  {% if forloop.first %}
    {% assign initial_tab_title = block.settings.tab_title %}
    {% if block.settings.collection %}
      {% assign initial_collection_url = collections[block.settings.collection].url %}
    {% endif %}
  {% endif %}
{% endfor %}
  <div class="{{ section.settings.section_width }} product-tabs-section color-{{ section.settings.color_scheme }}">
    <div class="tabs-inner-wrapper">

      <div class="tabs-wrapper">

        <div class="tabs-left">
          <div class="tab_heading">
            {{ section.settings.tab_heading }}
          </div>

          <ul class="product-tabs">
            {% for block in section.blocks %}
              {% assign collection = collections[block.settings.collection] %}
              <li class="{% if forloop.first %}active{% endif %}" data-tab="tab-{{ forloop.index }}" data-collection-url="{{ collection.url }}" data-shop-text="SHOP {{ block.settings.tab_title }}">
                {{ block.settings.tab_title }}
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}

        <div
          class="product-tabs-content {% if forloop.first %}active{% endif %}"
          id="tab-tab-{{ forloop.index }}"
        >

          {% if collection.products.size > 0 %}

            {% unless swiper_loaded %}
              <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
              {% assign swiper_loaded = true %}
            {% endunless %}

            <div class="product-slider swiper" data-product-count="{{ collection.products.size }}">

              <div class="swiper-wrapper">

                {% for product in collection.products %}

                  <div class="swiper-slide">

                    <div class="product-card">

                      <a href="{{ product.url }}" class="product-card-link">

                        <img
                          class="main-image"
                          src="{{ product.featured_image | image_url: width: 700 }}"
                          alt="{{ product.title }}"
                          loading="lazy"
                          width=""
                          height=""
                        >

                      </a>

                      <div class="thumbnail-wrapper">

                          {% for image in product.images limit: 15 %}

                            <div class="thumbnail-image-wrapper {% if forloop.first %}active{% endif %}">
                              <img class="thumbnail" src="{{ image | image_url: width: 100 }}" alt="{{ product.title }}" loading="lazy">
                            </div>

                          {% endfor %}

                         </div>

                      <h3 class="product-name">
                        {{ product.title }}
                      </h3>

                      <div class="product-price">
                        {{ product.price | money }}
                      </div>

                      <div class="product-meta">
                        {% if product.tags.size > 0 %}
                          {{ product.tags | join: ' / ' }}
                        {% endif %}
                      </div>

                    </div>

                  </div>

                {% endfor %}

              </div>

            </div>

          {% else %}
            <div class="empty-collection-message">
              <p>No products available in this collection</p>
            </div>
          {% endif %}

        </div>

      {% endfor %}
      <div>
        <a href="{{ initial_collection_url }}" class="shop-btn button">
          SHOP {{ initial_tab_title }}
        </a>
      </div>
    </div>
  </div>
  

<script defer>
document.addEventListener('DOMContentLoaded', function () {

  const tabs = document.querySelectorAll('.product-tabs li');
  const contents = document.querySelectorAll('.product-tabs-content');
  const shopBtn = document.querySelector('.shop-btn');

  // =========================================
  // Resize Observer
  // =========================================
  const resizeObserver = new ResizeObserver(
    debounce(handleThumbnailResize, 50)
  );

  function debounce(fn, delay) {

    let timeout;

    return function (...args) {

      clearTimeout(timeout);

      timeout = setTimeout(() => {
        fn.apply(this, args);
      }, delay);

    };

  }

  // =========================================
  // Update Shop Button
  // =========================================
  function updateShopButton(tab) {

    if (!shopBtn) return;

    const collectionUrl = tab.dataset.collectionUrl || '#';

    const shopText =
      tab.dataset.shopText || `SHOP ${tab.textContent.trim()}`;

    shopBtn.href = collectionUrl;
    shopBtn.textContent = shopText;
  }

  // =========================================
  // Tab Click
  // =========================================
  tabs.forEach((tab, i) => {

    tab.addEventListener('click', () => {

      tabs.forEach((t) => t.classList.remove('active'));
      contents.forEach((c) => c.classList.remove('active'));

      tab.classList.add('active');

      if (contents[i]) {
        contents[i].classList.add('active');
      }

      updateShopButton(tab);

      setTimeout(() => {

        handleThumbnailResize();
        bindThumbnailClicks();

      }, 200);

    });

  });

  // =========================================
  // Initial Active Tab
  // =========================================
  if (tabs.length) {

    const activeTab =
      document.querySelector('.product-tabs li.active') || tabs[0];

    updateShopButton(activeTab);

  }

  // =========================================
  // Swiper Init
  // =========================================
  document.querySelectorAll('.product-slider').forEach(function (sliderEl) {

    if (typeof Swiper !== 'undefined') {

      new Swiper(sliderEl, {

        slidesPerView: 4,
        spaceBetween: 28,

        breakpoints: {
          0: {
            slidesPerView: 1.3,
            spaceBetween: 20
          },
          768: {
            slidesPerView: 2,
            spaceBetween: 24
          },
          992: {
            slidesPerView: 3,
            spaceBetween: 28
          },
          1440: {
            slidesPerView: 4,
            spaceBetween: 28
          }
        },

        on: {

          init: function () {

            handleThumbnailResize();
            bindThumbnailClicks();

          },

          resize: function () {

            handleThumbnailResize();

          }

        }

      });

    }

  });

  // =========================================
  // Thumbnail Click
  // =========================================
  function thumbnailClickHandler() {

    const productCard = this.closest('.product-card');

    if (!productCard) return;

    const mainImage = productCard.querySelector('.main-image');

    if (mainImage) {
      mainImage.src = this.src;
    }

    const wrapper = this.closest('.thumbnail-wrapper');

    if (wrapper) {

      wrapper
        .querySelectorAll('.thumbnail-image-wrapper')
        .forEach(el => el.classList.remove('active'));

    }

    this.parentElement.classList.add('active');

  }

  // =========================================
  // Bind Thumbnail Click
  // =========================================
  function bindThumbnailClicks() {

    document.querySelectorAll('.thumbnail').forEach(thumbnail => {

      thumbnail.removeEventListener('click', thumbnailClickHandler);

      thumbnail.addEventListener('click', thumbnailClickHandler);

    });

  }

  // =========================================
  // Thumbnail Resize Logic
  // =========================================
  function handleThumbnailResize() {

    document.querySelectorAll('.product-card').forEach(card => {

      const wrapper = card.querySelector('.thumbnail-wrapper');

      if (!wrapper) return;

      const thumbnails = Array.from(
        wrapper.querySelectorAll('.thumbnail-image-wrapper')
      );

      if (!thumbnails.length) return;

      // Skip if expanded
      if (wrapper.classList.contains('show-all')) {

        thumbnails.forEach((thumb) => {
          thumb.style.display = '';
        });

        return;
      }

      // Remove old counter
      const oldCounter =
        wrapper.querySelector('.thumbnail-more-counter');

      if (oldCounter) {
        oldCounter.remove();
      }

      // Reset thumbnails
      thumbnails.forEach((thumb) => {
        thumb.style.display = '';
      });

      let hiddenCount = 0;
      let currentWidth = 0;

      const wrapperWidth = wrapper.offsetWidth;
      const gap = 8;

      thumbnails.forEach((thumb, index) => {

        const thumbWidth = thumb.offsetWidth + gap;

        currentWidth += thumbWidth;

        if (currentWidth > wrapperWidth) {

          hiddenCount++;

          thumb.style.display = 'none';

        }

      });

      // Hide one extra for counter space
      if (hiddenCount > 0) {

        const lastVisible =
          thumbnails.length - hiddenCount - 1;

        if (thumbnails[lastVisible]) {

          thumbnails[lastVisible].style.display = 'none';

          hiddenCount++;

        }

      }

      // Create Counter
      if (hiddenCount > 0) {

        const counter = document.createElement('div');

        counter.className = 'thumbnail-more-counter thumbnail';

        counter.innerHTML = `+${hiddenCount}`;

        wrapper.appendChild(counter);

        counter.addEventListener('click', function () {

          wrapper.classList.add('show-all');

          thumbnails.forEach((thumb) => {
            thumb.style.display = '';
          });

          counter.remove();

          bindThumbnailClicks();

        });

      }

    });

  }

  // =========================================
  // Observe Product Cards
  // =========================================
  document.querySelectorAll('.product-card').forEach(card => {

    resizeObserver.observe(card);

  });

  // =========================================
  // Initial Load
  // =========================================
  bindThumbnailClicks();
  handleThumbnailResize();

  // =========================================
  // Window Resize
  // =========================================
  window.addEventListener('resize', function () {

    handleThumbnailResize();

  });

});
</script>