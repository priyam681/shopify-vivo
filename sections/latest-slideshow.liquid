<section
  class="motion-gallery color-{{ section.settings.color_scheme }}"
  style="
    --padding-top: {{ section.settings.padding_top }}px;
    --padding-bottom: {{ section.settings.padding_bottom }}px;
    --gap: {{ section.settings.gap }}px;
    --speed: {{ section.settings.speed }}s;
  "
>

  <div class="motion-gallery__wrapper">

    <div class="motion-gallery__track">

      {% for block in section.blocks %}

        <div
          class="motion-gallery__item"
          {{ block.shopify_attributes }}
          style="
            --desktop-width: {{ block.settings.desktop_width }}px;
            --desktop-height: {{ block.settings.desktop_height }}px;

            --mobile-width: {{ block.settings.mobile_width }}px;
            --mobile-height: {{ block.settings.mobile_height }}px;

            --radius: {{ block.settings.radius }}px;
          "
        >

          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="motion-gallery__link">
          {% endif %}

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '300,500,700,900,1200,1400,1600',
                sizes: '(min-width: 990px) 25vw, 70vw',
                class: 'motion-gallery__image'
            }}

          {% else %}

            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}

          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% endif %}

        </div>

      {% endfor %}

      {% for block in section.blocks %}

        <div
          class="motion-gallery__item motion-gallery__item--duplicate"
          style="
            --desktop-width: {{ block.settings.desktop_width }}px;
            --desktop-height: {{ block.settings.desktop_height }}px;

            --mobile-width: {{ block.settings.mobile_width }}px;
            --mobile-height: {{ block.settings.mobile_height }}px;

            --radius: {{ block.settings.radius }}px;
          "
        >

          {% if block.settings.image != blank %}

            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                widths: '300,500,700,900,1200,1400,1600',
                sizes: '(min-width: 990px) 25vw, 70vw',
                class: 'motion-gallery__image'
            }}

          {% endif %}

        </div>

      {% endfor %}

    </div>

  </div>

</section>

<style>

.motion-gallery{
  overflow:hidden;
  padding-top:var(--padding-top);
  padding-bottom:var(--padding-bottom);
}

.motion-gallery__wrapper{
  overflow:hidden;
  width:100%;
}

.motion-gallery__track{
  display:flex;
  gap:var(--gap);
  width:max-content;
  animation:motionGalleryScroll var(--speed) linear infinite;
}

.motion-gallery__item{
  width:var(--desktop-width);
  height:var(--desktop-height);
  border-radius:var(--radius);
  overflow:hidden;
  flex-shrink:0;
  position:relative;
}

.motion-gallery__link{
  display:block;
  width:100%;
  height:100%;
}

.motion-gallery__image{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
  transition:transform .5s ease;
}

.motion-gallery__item:hover .motion-gallery__image{
  transform:scale(1.05);
}

@keyframes motionGalleryScroll{

  from{
    transform:translateX(0);
  }

  to{
    transform:translateX(calc(-50% - (var(--gap) / 2)));
  }

}

@media screen and (max-width:749px){

  .motion-gallery__track{
    gap:calc(var(--gap) / 2);
  }

  .motion-gallery__item{
    width:var(--mobile-width);
    height:var(--mobile-height);
  }

}

</style>

{% schema %}
{
  "name": "Motion gallery",
  "tag": "section",
  "class": "section",

  "settings": [

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },

    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 100,
      "step": 1,
      "unit": "s",
      "label": "Animation speed",
      "default": 40
    },

    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Gap",
      "default": 24
    },

    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },

    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 40
    }

  ],

  "blocks": [

    {
      "type": "image",
      "name": "Image",

      "settings": [

        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },

        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },

        {
          "type": "range",
          "id": "desktop_width",
          "min": 200,
          "max": 700,
          "step": 10,
          "unit": "px",
          "label": "Desktop width",
          "default": 420
        },

        {
          "type": "range",
          "id": "desktop_height",
          "min": 200,
          "max": 800,
          "step": 10,
          "unit": "px",
          "label": "Desktop height",
          "default": 520
        },

        {
          "type": "range",
          "id": "mobile_width",
          "min": 120,
          "max": 400,
          "step": 10,
          "unit": "px",
          "label": "Mobile width",
          "default": 220
        },

        {
          "type": "range",
          "id": "mobile_height",
          "min": 120,
          "max": 500,
          "step": 10,
          "unit": "px",
          "label": "Mobile height",
          "default": 280
        },

        {
          "type": "range",
          "id": "radius",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "label": "Border radius",
          "default": 0
        }

      ]
    }

  ],

  "presets": [
    {
      "name": "Motion gallery"
    }
  ]
}
{% endschema %}